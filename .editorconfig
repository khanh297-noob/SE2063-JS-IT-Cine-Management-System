# Định dạng chung cho IntelliJ IDEA và NetBeans (cả hai đều đọc file này),
# để IDE không tự đổi thụt lề / mã hoá của file người khác và gây conflict khi merge.
# Kiểu xuống dòng do .gitattributes quản lý nên không đặt ở đây.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true

[*.md]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
