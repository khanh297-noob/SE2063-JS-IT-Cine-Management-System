<%@ page pageEncoding="UTF-8" %>
<%-- Thông báo nổi (toast).
     - Servlet gọi session.setAttribute("flashMsg", ...) trước khi sendRedirect -> hiện 1 lần rồi xóa.
     - Servlet gọi request.setAttribute("error", ...) trước khi forward -> hiện lỗi đỏ. --%>
<c:if test="${not empty sessionScope.flashMsg}">
    <div class="toast ${sessionScope.flashType}"><c:out value="${sessionScope.flashMsg}"/></div>
    <c:remove var="flashMsg" scope="session"/>
    <c:remove var="flashType" scope="session"/>
</c:if>
<c:if test="${not empty error}">
    <div class="toast error"><c:out value="${error}"/></div>
</c:if>
