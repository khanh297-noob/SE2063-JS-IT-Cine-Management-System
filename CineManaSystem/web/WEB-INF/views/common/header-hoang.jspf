<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%--
  Đầu trang dùng chung. Trước khi include, trang cha đặt:
    pageTitle  tiêu đề tab trình duyệt
    nav        mục menu đang chọn: branches | rooms | room-types (quản lý chi nhánh)
                                    hoặc movies | genres | showtimes | schedule (quản lý phim + suất chiếu)
    extraCss   (tuỳ chọn) CSS thêm của trang, vd "booking-hiep"
--%>
<c:set var="moduleCss" value="branch-hoang,movie-hoang${empty extraCss ? '' : ','}${extraCss}"/>
<%@ include file="/WEB-INF/views/common/head-hoang.jspf" %>
<body>
<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="${ctx}/manage">CineGo</a>
        <%-- Quản lý chi nhánh và quản lý phim là hai chức năng riêng (hai ô trên trang chủ quản trị),
             nên menu chỉ hiện các mục của chức năng đang mở. --%>
        <c:choose>
            <c:when test="${nav == 'movies' or nav == 'genres' or nav == 'showtimes' or nav == 'schedule'}">
                <nav class="topnav" aria-label="Quản lý phim">
                    <a href="${ctx}/manage/movie" class="${nav == 'movies' ? 'current' : ''}">Phim</a>
                    <a href="${ctx}/manage/genres" class="${nav == 'genres' ? 'current' : ''}">Thể loại</a>
                    <a href="${ctx}/manager/showtimes" class="${nav == 'showtimes' ? 'current' : ''}">Suất chiếu</a>
                    <a href="${ctx}/manager/schedule" class="${nav == 'schedule' ? 'current' : ''}">Lịch tổng hợp</a>
                </nav>
            </c:when>
            <c:otherwise>
                <nav class="topnav" aria-label="Quản lý chi nhánh">
                    <a href="${ctx}/manage/branch" class="${nav == 'branches' ? 'current' : ''}">Chi nhánh</a>
                    <a href="${ctx}/manage/rooms" class="${nav == 'rooms' ? 'current' : ''}">Phòng chiếu</a>
                    <a href="${ctx}/manage/room-types" class="${nav == 'room-types' ? 'current' : ''}">Loại phòng</a>
                </nav>
            </c:otherwise>
        </c:choose>
    </div>
</header>
<main class="page">
<c:if test="${not empty sessionScope.flashSuccess}">
    <div class="notice notice-ok" role="status"><c:out value="${sessionScope.flashSuccess}"/></div>
    <c:remove var="flashSuccess" scope="session"/>
</c:if>
<c:if test="${not empty sessionScope.flashError}">
    <div class="notice notice-error" role="alert"><c:out value="${sessionScope.flashError}"/></div>
    <c:remove var="flashError" scope="session"/>
</c:if>
<c:if test="${not empty errors}">
    <div class="notice notice-error" role="alert">
        Chưa lưu được. Sửa các mục sau rồi thử lại:
        <ul><c:forEach var="e" items="${errors}"><li><c:out value="${e}"/></li></c:forEach></ul>
    </div>
</c:if>
