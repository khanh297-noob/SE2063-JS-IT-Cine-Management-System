<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%--
  Đầu trang của Giao diện khách hàng (/movies...). Không dùng thanh menu quản trị.
  Trước khi include, trang cha đặt:
    pageTitle    tiêu đề tab
    customerNav  mục đang chọn: home | genre | year | lang | branch
  Servlet đặt sẵn: menu (genres, years, languages), menuBranches (chi nhánh đang hoạt động).
--%>
<c:set var="moduleCss" value="customer-hoang"/>
<%@ include file="/WEB-INF/views/common/head-hoang.jspf" %>
<body>
<header class="topbar">
    <div class="topbar-inner customer-topbar-inner">
        <a class="brand" href="${ctx}/movies">CineGo</a>
        <nav class="cnav" aria-label="Duyệt phim">
            <a class="cnav-link ${customerNav == 'home' ? 'current' : ''}" href="${ctx}/movies">Trang chủ</a>

            <div class="cnav-item">
                <button type="button" class="cnav-link ${customerNav == 'genre' ? 'current' : ''}" aria-haspopup="true">Thể loại</button>
                <ul class="cnav-menu">
                    <c:forEach var="g" items="${menu.genres}">
                        <li><a href="${ctx}/movies?genreId=${g.genreId}"><c:out value="${g.name}"/></a></li>
                    </c:forEach>
                    <c:if test="${empty menu.genres}"><li class="cnav-empty">Chưa có phim</li></c:if>
                </ul>
            </div>

            <div class="cnav-item">
                <button type="button" class="cnav-link ${customerNav == 'year' ? 'current' : ''}" aria-haspopup="true">Năm phát hành</button>
                <ul class="cnav-menu">
                    <c:forEach var="y" items="${menu.years}">
                        <li><a href="${ctx}/movies?year=${y}">${y}</a></li>
                    </c:forEach>
                    <c:if test="${empty menu.years}"><li class="cnav-empty">Chưa có phim</li></c:if>
                </ul>
            </div>

            <div class="cnav-item">
                <button type="button" class="cnav-link ${customerNav == 'lang' ? 'current' : ''}" aria-haspopup="true">Ngôn ngữ</button>
                <ul class="cnav-menu">
                    <c:forEach var="l" items="${menu.languages}">
                        <c:url var="langUrl" value="/movies"><c:param name="lang" value="${l}"/></c:url>
                        <li><a href="${langUrl}"><c:out value="${l}"/></a></li>
                    </c:forEach>
                    <c:if test="${empty menu.languages}"><li class="cnav-empty">Chưa có phim</li></c:if>
                </ul>
            </div>

            <div class="cnav-item">
                <button type="button" class="cnav-link ${customerNav == 'branch' ? 'current' : ''}" aria-haspopup="true">Chi nhánh</button>
                <ul class="cnav-menu">
                    <c:forEach var="mb" items="${menuBranches}">
                        <li><a href="${ctx}/branch?id=${mb.branchId}"><c:out value="${mb.name}"/>
                            <span class="cnav-sub"><c:out value="${mb.city}"/></span></a></li>
                    </c:forEach>
                    <c:if test="${empty menuBranches}"><li class="cnav-empty">Chưa có chi nhánh hoạt động</li></c:if>
                </ul>
            </div>
        </nav>
        <a class="switch-ui" href="${ctx}/">Đổi giao diện</a>
    </div>
</header>
<main class="page page-wide">
<c:if test="${not empty sessionScope.flashSuccess}">
    <div class="notice notice-ok" role="status"><c:out value="${sessionScope.flashSuccess}"/></div>
    <c:remove var="flashSuccess" scope="session"/>
</c:if>
<c:if test="${not empty sessionScope.flashError}">
    <div class="notice notice-error" role="alert"><c:out value="${sessionScope.flashError}"/></div>
    <c:remove var="flashError" scope="session"/>
</c:if>
<c:if test="${not empty errors}">
    <div class="notice notice-error" role="alert">
        Chưa gửi được. Sửa các mục sau rồi thử lại:
        <ul><c:forEach var="e" items="${errors}"><li><c:out value="${e}"/></li></c:forEach></ul>
    </div>
</c:if>
