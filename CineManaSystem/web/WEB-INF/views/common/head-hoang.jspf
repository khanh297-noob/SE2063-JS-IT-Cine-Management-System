<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Phần <head> dùng chung cho trang quản trị (header.jspf) và trang khách (customer-header.jspf).
     Luôn nạp base-hoang.css; thêm các file trong moduleCss (đặt trước khi include). --%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<%-- assetVer = thời điểm sửa gần nhất của file trong /assets, gắn vào ?v= của CSS/JS
     để trình duyệt tải lại ngay khi file đổi thay vì dùng bản cũ trong cache. --%>
<%
    long assetVer = 0;
    for (String dir : new String[] {"/assets/css", "/assets/js"}) {
        String real = application.getRealPath(dir);
        java.io.File[] files = real == null ? null : new java.io.File(real).listFiles();
        if (files != null) for (java.io.File f : files) assetVer = Math.max(assetVer, f.lastModified());
    }
    request.setAttribute("assetVer", assetVer);
%>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> - CineGo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${ctx}/assets/css/base-hoang.css?v=${assetVer}">
    <%-- CSS theo chức năng: trang cha đặt moduleCss, vd "branch-hoang,movie-hoang" hoặc "customer-hoang" --%>
    <c:forTokens var="css" items="${moduleCss}" delims=",">
    <link rel="stylesheet" href="${ctx}/assets/css/${css}.css?v=${assetVer}">
    </c:forTokens>
</head>
