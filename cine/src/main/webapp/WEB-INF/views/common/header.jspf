<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%--
  Đầu trang dùng chung. Trước khi include, trang cha đặt:
    pageTitle  tiêu đề tab trình duyệt
    nav        mục menu đang chọn: branches | rooms | room-types | movies | genres
    publicPage true nếu là trang cho khách (ẩn menu quản trị)
--%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<%-- assetVer = thời điểm sửa gần nhất của file trong /assets, gắn vào ?v= của CSS/JS
     để trình duyệt tải lại ngay khi file đổi thay vì dùng bản cũ trong cache. --%>
<%
    long assetVer = 0;
    for (String dir : new String[] {"/assets/css", "/assets/js"}) {
        String real = application.getRealPath(dir);
        java.io.File[] files = real == null ? null : new java.io.File(real).listFiles();
        if (files != null) for (java.io.File f : files) assetVer = Math.max(assetVer, f.lastModified());
    }
    request.setAttribute("assetVer", assetVer);
%>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> - CineGo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${ctx}/assets/css/app.css?v=${assetVer}">
</head>
<body>
<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="${ctx}/">CineGo</a>
        <c:if test="${not publicPage}">
            <nav class="topnav" aria-label="Quản trị">
                <a href="${ctx}/manage/branches" class="${nav == 'branches' ? 'current' : ''}">Chi nhánh</a>
                <a href="${ctx}/manage/rooms" class="${nav == 'rooms' ? 'current' : ''}">Phòng chiếu</a>
                <a href="${ctx}/manage/room-types" class="${nav == 'room-types' ? 'current' : ''}">Loại phòng</a>
                <a href="${ctx}/manage/movies" class="${nav == 'movies' ? 'current' : ''}">Phim</a>
                <a href="${ctx}/manage/genres" class="${nav == 'genres' ? 'current' : ''}">Thể loại</a>
            </nav>
        </c:if>
    </div>
</header>
<main class="page">
<c:if test="${not empty sessionScope.flashSuccess}">
    <div class="notice notice-ok" role="status"><c:out value="${sessionScope.flashSuccess}"/></div>
    <c:remove var="flashSuccess" scope="session"/>
</c:if>
<c:if test="${not empty sessionScope.flashError}">
    <div class="notice notice-error" role="alert"><c:out value="${sessionScope.flashError}"/></div>
    <c:remove var="flashError" scope="session"/>
</c:if>
<c:if test="${not empty errors}">
    <div class="notice notice-error" role="alert">
        Chưa lưu được. Sửa các mục sau rồi thử lại:
        <ul><c:forEach var="e" items="${errors}"><li><c:out value="${e}"/></li></c:forEach></ul>
    </div>
</c:if>
