<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="me" value="${sessionScope.user}"/>
<fmt:setLocale value="vi_VN"/>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${empty pageTitle ? 'Cine Star' : pageTitle} · Cine Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${ctx}/assets/css/app.css">
</head>
<body>
<header class="topbar">
    <a class="brand" href="${ctx}/"><span class="brand-mark">▶</span> Cine<b>Star</b></a>
    <nav class="nav">
        <a href="${ctx}/">Lịch chiếu</a>
        <c:if test="${me.manager or me.admin}">
            <a href="${ctx}/manager/showtimes">Quản lý suất chiếu</a>
            <a href="${ctx}/manager/schedule">Lịch tổng hợp</a>
        </c:if>
        <c:if test="${me.cashier}">
            <a href="${ctx}/pos">Bán vé tại quầy</a>
            <a href="${ctx}/pos/bookings">Tra cứu / Hủy đơn</a>
        </c:if>
        <c:if test="${me.customer}">
            <a href="${ctx}/profile/history">Vé của tôi</a>
            <a href="${ctx}/profile">Tài khoản</a>
        </c:if>
    </nav>
    <div class="who">
        <c:choose>
            <c:when test="${not empty me}">
                <span class="who-name">${fn:escapeXml(me.fullName)}</span>
                <span class="role-chip">${me.role}<c:if test="${not empty me.branchName}"> · ${fn:escapeXml(me.branchName)}</c:if></span>
                <a class="btn btn-ghost btn-sm" href="${ctx}/logout">Đăng xuất</a>
            </c:when>
            <c:otherwise><a class="btn btn-primary btn-sm" href="${ctx}/login">Đăng nhập</a></c:otherwise>
        </c:choose>
    </div>
</header>
<c:if test="${not empty sessionScope.flash}">
    <div class="toast toast-${sessionScope.flash.type}" role="status">${fn:escapeXml(sessionScope.flash.message)}</div>
    <c:remove var="flash" scope="session"/>
</c:if>
<main class="container">
